# NOTE: vendor/opentelemetry-demo/.gitignore ignores 7 files that upstream
# actually tracks (src/currency/proto/..., src/flagd-ui/assets/vendor/...,
# src/flagd-ui/rel/overlays/bin/...). A shallower .gitignore cannot re-include
# them, so they are added with `git add -f`; once tracked they stay tracked.
