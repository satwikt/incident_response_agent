      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "webstore-metrics"},
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket{service_name=\"shipping\"}[5m])))",
