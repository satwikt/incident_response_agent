      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "webstore-metrics"},
          "editorMode": "code",
          "expr": "sum(rate(traces_span_metrics_calls_total{service_name=\"payment\",status_code=\"STATUS_CODE_ERROR\"}[5m]))",
          "instant": false,
          "legendFormat": "payment error spans/s",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Payment error spans",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "webstore-metrics"},
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never"},
