# Copy to .env (git-ignored) and fill in. Generate each secret with:  openssl rand -hex 24

# Shared secret for telemetry event ingest
INGEST_KEY=

# Service control plane & Chaos injection keys
CHAOS_KEY=
OPS_KEY=

# NVIDIA NIM & Nemotron Tiers (nano, super, ultra)
AGENT_MODEL=super
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Nano: minimal reasoning for same-context recurring incidents (fast adjustments)
NEMOTRON_NANO_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Super: mid reasoning for similar incidents with different context (guided RCA)
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Ultra: deep multi-step reasoning for completely new incidents (scratch RCA)
NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Groq Fallback Model (fallback if NVIDIA NIM fails or is unconfigured)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Memory (Hindsight)
MEMORY_MODE=on
HINDSIGHT_LLM_PROVIDER=groq
HINDSIGHT_LLM_MODEL=qwen/qwen3.8-27b
HINDSIGHT_LLM_API_KEY=

# Optional: alert destination
DISCORD_WEBHOOK_URL=

# Watcher and thresholds
WATCHER_INTERVAL_MINUTES=1
ALERT_ERROR_RATE_THRESHOLD=10
ALERT_LATENCY_P95_MS=1000
MIN_REQUESTS=20

# Incident lifecycle
RECOVERY_WINDOWS=3
CLOSE_RATIO=0.5
RECURRENCE_WINDOW_HOURS=24
RENOTIFY_MINUTES=30
MAX_OPEN_INCIDENTS=5
AGENT_MAX_RUNS_PER_HOUR=12
AGENT_TIMEOUT_S=120
AGENT_MAX_LLM_CALLS=6
AGENT_DAILY_TOKEN_BUDGET=150000
AGENT_REASONING_EFFORT=low
AGENT_MAX_TOKENS=4096
BREAKER_FAILURES=3
BREAKER_PAUSE_S=300
PUBLIC_BASE_URL=
