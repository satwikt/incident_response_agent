# Copy to .env (git-ignored) and fill in. Generate each secret with:  openssl rand -hex 24

# Ingest keys, one per service: service:key,service2:key2 (compose falls back to these defaults when unset)
INGEST_KEYS=checkout:key-for-checkout,catalog:key-for-catalog,frontend:key-for-frontend

# Service control plane & Chaos injection keys
CHAOS_KEY=
OPS_KEY=

# Inference. Nebius Token Factory is the primary provider (OpenAI-compatible); NVIDIA NIM and Groq are optional fallbacks,
# tried in that order, and any provider whose key is empty is skipped. The stack runs with only NEBIUS_API_KEY.
INFERENCE_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Token Factory model ids per tier: run `python scripts/list_models.py` to see what your key can use.
NEBIUS_NANO_MODEL=
NEBIUS_SUPER_MODEL=
NEBIUS_ULTRA_MODEL=

# NVIDIA NIM & Nemotron Tiers (nano, super, ultra)  (optional fallback; used as primary with INFERENCE_PROVIDER=nvidia)
AGENT_MODEL=super
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Nano: minimal reasoning for same-context recurring incidents (fast adjustments)
NEMOTRON_NANO_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Super: mid reasoning for similar incidents with different context (guided RCA)
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Ultra: deep multi-step reasoning for completely new incidents (scratch RCA)
NEMOTRON_ULTRA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Groq Fallback Model (fallback if NVIDIA NIM fails or is unconfigured)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Memory (Hindsight)
MEMORY_MODE=on
# on: every "Fix Failed" click is also written to Hindsight (runbook). off: stored with the fix at resolution; saves memory-LLM quota.
MEMORY_RETAIN_FAILED_ATTEMPTS=on
# The memory model extracts facts from resolved incidents. Option A (default): Groq.
HINDSIGHT_LLM_PROVIDER=groq
HINDSIGHT_LLM_MODEL=qwen/qwen3.8-27b
HINDSIGHT_LLM_API_KEY=
HINDSIGHT_LLM_BASE_URL=
# Option B: Nebius Token Factory instead of Groq (Hindsight supports any OpenAI-compatible endpoint). Replace the four
# lines above with these, using a model id from `python scripts/list_models.py` and the same key as NEBIUS_API_KEY:
#   HINDSIGHT_LLM_PROVIDER=openai
#   HINDSIGHT_LLM_MODEL=<token factory model id>
#   HINDSIGHT_LLM_API_KEY=<your Nebius key>
#   HINDSIGHT_LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Max output tokens Hindsight asks the memory LLM for. Keep <= the model limit (Groq: 16384) or every retain fails.
HINDSIGHT_RETAIN_MAX_COMPLETION_TOKENS=16384

# Optional: alert destination
DISCORD_WEBHOOK_URL=

# Watcher and thresholds
WATCHER_INTERVAL_MINUTES=1
ALERT_ERROR_RATE_THRESHOLD=10
ALERT_LATENCY_P95_MS=1000
# Requests the watcher's 1-minute window needs before an error rate counts as a breach. The demo shop sends only
# ~4 checkouts/min, so 20 never opens an incident; 3 does.
MIN_REQUESTS=3

# Incident lifecycle
RECOVERY_WINDOWS=3
CLOSE_RATIO=0.5
RECURRENCE_WINDOW_HOURS=24
RENOTIFY_MINUTES=30
MAX_OPEN_INCIDENTS=5
AGENT_MAX_RUNS_PER_HOUR=12
AGENT_TIMEOUT_S=120
AGENT_MAX_LLM_CALLS=6
AGENT_DAILY_TOKEN_BUDGET=150000
AGENT_REASONING_EFFORT=low
AGENT_MAX_TOKENS=8192
BREAKER_FAILURES=3
BREAKER_PAUSE_S=300
PUBLIC_BASE_URL=
