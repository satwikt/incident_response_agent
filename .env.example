# Copy to .env (git-ignored) and fill in. Generate each secret with:  openssl rand -hex 24

# Shared secret the demo app uses to push events; the Copilot binds it to the service "todo-app".
INGEST_KEY=

# Demo app control plane. Leave empty to disable (endpoints fail closed).
#   CHAOS_KEY injects incidents (test harness only). OPS_KEY runs operational actions.
CHAOS_KEY=
OPS_KEY=

# Agent LLM. A plain name (gemini-3.5-flash) uses Gemini directly; provider/model (cerebras/gpt-oss-120b) goes
# through LiteLLM. Free tiers are rate limited per model (see docs/DESIGN.md section 14).
AGENT_MODEL=cerebras/gpt-oss-120b
GROQ_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_API_KEY=

# Memory (Hindsight). MEMORY_MODE=off disables it (the benchmark's baseline). Hindsight uses its own LLM for extraction:
MEMORY_MODE=on
HINDSIGHT_LLM_PROVIDER=groq
HINDSIGHT_LLM_MODEL=openai/gpt-oss-20b   # a different model from the agent: its own per-minute and daily quota
HINDSIGHT_LLM_API_KEY=

# Optional: alert destination
DISCORD_WEBHOOK_URL=

# Watcher and thresholds (demo-friendly defaults)
WATCHER_INTERVAL_MINUTES=1
ALERT_ERROR_RATE_THRESHOLD=10
ALERT_LATENCY_P95_MS=1000
MIN_REQUESTS=20

# Incident lifecycle (demo-friendly values shown in comments)
RECOVERY_WINDOWS=3          # consecutive healthy windows before an incident auto-resolves (demo: 2)
CLOSE_RATIO=0.5             # a route is "healthy" only below this fraction of the alert thresholds
RECURRENCE_WINDOW_HOURS=24  # a returning fingerprint inside this window links to the resolved incident
RENOTIFY_MINUTES=30         # reminder interval for an unacknowledged incident
MAX_OPEN_INCIDENTS=5
AGENT_MAX_RUNS_PER_HOUR=12  # LLM diagnosis budget
AGENT_TIMEOUT_S=120
AGENT_MAX_LLM_CALLS=6       # hard cap on model calls per diagnosis (a normal run needs 2)
AGENT_DAILY_TOKEN_BUDGET=150000   # stop calling the model after this many tokens in 24 h (Groq free tier: 200,000/day/model; 0 = off)
AGENT_REASONING_EFFORT=low  # low|medium|high|none: reasoning models spend most tokens thinking
AGENT_MAX_TOKENS=1200       # cap per model reply
BREAKER_FAILURES=3          # consecutive LLM failures that pause diagnosis
BREAKER_PAUSE_S=300
PUBLIC_BASE_URL=            # optional: adds an incident link to alerts

# Scenario tuning for the demo app (defaults shown)
FAULT_ERROR_RATE=0.3
POOL_SIZE=10
POOL_WAIT_S=2.0
MEM_LIMIT_MB=150
LATENCY_MIN_S=2.0
LATENCY_MAX_S=5.0
