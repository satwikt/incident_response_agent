# Environment Configuration for SRE Copilot (Google ADK)

# Google GenAI API Key for Google ADK
GOOGLE_API_KEY=you_gemini_key
GOOGLE_GENAI_USE_ENTERPRISE=0

# Target application service name (must match service.name in the Demo app's OTel config)
APP_SERVICE_NAME=todo-app

# Observability endpoints (defaults assume host.docker.internal when run in container)
PROMETHEUS_URL=http://host.docker.internal:9090
LOKI_URL=http://host.docker.internal:3100
TEMPO_URL=http://host.docker.internal:3200

# App health and admin endpoints
APP_HEALTH_URL=http://host.docker.internal:8000/health
APP_ADMIN_URL=http://host.docker.internal:8000/admin/faults

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379

# LLM Configuration
GEMINI_MODEL=gemini-3.5-flash-lite

# Reference documentation path (persisted alongside the SQLite DB via the ./data volume mount)
REFERENCE_DOCS_PATH=/app/data/reference_docs

# ── Proactive Watcher ─────────────────────────────────────────────────────────
# How often the watcher polls observability sources (minutes).
WATCHER_INTERVAL_MINUTES=1

# Alert thresholds
ALERT_ERROR_RATE_THRESHOLD=1         # % error rate per route
ALERT_LATENCY_P95_MS=1000            # milliseconds
ALERT_SLOW_TRACE_COUNT=3             # number of slow traces
ALERT_SLOW_TRACE_MIN_MS=500          # minimum ms to count as slow
ALERT_LOG_KEYWORDS=ERROR,CRITICAL,Exception,Traceback
ALERT_LOG_SCAN_LIMIT=100              # max log lines per scan

# ── Discord Notifications ─────────────────────────────────────────────────────
# Paste your Discord channel webhook URL here.
# To create one: Channel Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=