# Copy to .env (git-ignored) and fill in ONE of the two blocks.

# A) Gemini (free tier is rate limited / overloaded; billing recommended)
GEMINI_API_KEY=
# HINDSIGHT_LLM_MODEL=gemini-3.1-flash-lite

# B) Groq (free tier, natively supported by Hindsight)
# HINDSIGHT_LLM_PROVIDER=groq
# HINDSIGHT_LLM_MODEL=openai/gpt-oss-20b   # measured: 3 s async retain; gpt-oss-120b hit a 27 min cooldown
# HINDSIGHT_LLM_API_KEY=

# Optional: Gemini embeddings instead of the small local model
# HINDSIGHT_EMBEDDINGS_PROVIDER=google
